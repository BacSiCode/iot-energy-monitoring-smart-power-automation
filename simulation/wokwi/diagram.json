{
  "version": 1,
  "author": "IoT Project 55",
  "editor": "wokwi",
  "serialMonitor": { "display": "always", "collapse": false },
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": -120, "left": 260, "attrs": { "delayTime": "2" } },
    { "type": "wokwi-potentiometer", "id": "currentInput", "top": 40, "left": 300, "attrs": { "value": "20" } },
    { "type": "wokwi-slide-switch", "id": "storeState", "top": 160, "left": 300, "attrs": { "value": "0", "bounce": "0" } },
    { "type": "wokwi-pushbutton", "id": "overrideBtn", "top": 240, "left": 290, "attrs": { "color": "blue", "label": "OVERRIDE", "bounce": "0" } },
    { "type": "wokwi-relay-module", "id": "relay", "top": -20, "left": 520, "attrs": {} },
    { "type": "wokwi-resistor", "id": "loadResistor", "top": 100, "left": 620, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "loadLed", "top": 150, "left": 700, "attrs": { "color": "yellow", "label": "LOAD" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 290, "left": 520, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-resistor", "id": "statusResistor", "top": 330, "left": 140, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "statusLed", "top": 300, "left": 240, "attrs": { "color": "green", "label": "MQTT" } },
    { "type": "wokwi-resistor", "id": "alarmResistor", "top": 380, "left": 140, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "alarmLed", "top": 350, "left": 240, "attrs": { "color": "red", "label": "ALARM" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "pir:VCC", "red", [] ],
    [ "esp:GND.1", "pir:GND", "black", [] ],
    [ "esp:D27", "pir:OUT", "green", [] ],

    [ "esp:3V3", "currentInput:VCC", "red", [] ],
    [ "esp:GND.1", "currentInput:GND", "black", [] ],
    [ "esp:D34", "currentInput:SIG", "orange", [] ],

    [ "esp:GND.1", "storeState:1", "black", [] ],
    [ "esp:D26", "storeState:2", "blue", [] ],
    [ "esp:3V3", "storeState:3", "red", [] ],

    [ "esp:D14", "overrideBtn:1.l", "blue", [] ],
    [ "esp:GND.1", "overrideBtn:2.l", "black", [] ],

    [ "esp:VIN", "relay:VCC", "red", [] ],
    [ "esp:GND.2", "relay:GND", "black", [] ],
    [ "esp:D25", "relay:IN", "purple", [] ],
    [ "esp:3V3", "relay:COM", "red", [] ],
    [ "relay:NO", "loadResistor:1", "yellow", [] ],
    [ "loadResistor:2", "loadLed:A", "yellow", [] ],
    [ "loadLed:C", "esp:GND.2", "black", [] ],

    [ "esp:D33", "buzzer:2", "purple", [] ],
    [ "esp:GND.2", "buzzer:1", "black", [] ],

    [ "esp:D4", "statusResistor:1", "green", [] ],
    [ "statusResistor:2", "statusLed:A", "green", [] ],
    [ "statusLed:C", "esp:GND.2", "black", [] ],

    [ "esp:D19", "alarmResistor:1", "red", [] ],
    [ "alarmResistor:2", "alarmLed:A", "red", [] ],
    [ "alarmLed:C", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
