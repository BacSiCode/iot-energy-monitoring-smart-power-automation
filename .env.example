# IoT Project 55 - environment template.
# Copy to .env (gitignored). NEVER commit .env or real credentials.

# --- Ports published on the host ---------------------------------------------
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001
NODERED_PORT=1880
DASHBOARD_PORT=8080

# --- Broker used by Node-RED -------------------------------------------------
# mosquitto          -> local container (real ESP32 on the LAN, or scripts/device-sim.js)
# broker.hivemq.com  -> public broker (device running in Wokwi)
NODERED_MQTT_HOST=mosquitto
NODERED_MQTT_PORT=1883

# --- Automation ----------------------------------------------------------------
TZ=Asia/Ho_Chi_Minh
# SWITCH = store OPEN/CLOSED from the slide switch (deterministic demo)
# SCHEDULE = store OPEN/CLOSED from STORE_OPEN_TIME / STORE_CLOSE_TIME
STORE_STATUS_SOURCE=SWITCH
STORE_OPEN_TIME=08:00
STORE_CLOSE_TIME=22:00
# Demo values; production suggestion: 60 and 30
AUTO_SHUTDOWN_DELAY_SECONDS=10
DEVICE_TIMEOUT_SECONDS=15
# ALERT_ONLY = alarm + event; CUTOFF = also switch the relay OFF
SAFETY_MODE=ALERT_ONLY

# --- Secrets (leave empty for local development) -----------------------------
# Random string that encrypts Node-RED credentials (flows_cred.json)
NODE_RED_CREDENTIAL_SECRET=
# Editor login; hash with: docker compose run --rm nodered node-red admin hash-pw
NODE_RED_ADMIN_USER=
NODE_RED_ADMIN_PASSWORD_HASH=
# Escape every $ in the bcrypt hash as $$ inside this file.

# Device credentials are NOT here: see firmware/esp32/include/config.example.h
